generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sucursal {
  id               String             @id @default(uuid())
  nombre           String             @unique
  direccion        String?
  activa           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  principal        Boolean            @default(false)
  movimientosStock         MovimientoStock[] @relation("MovimientoOrigen")
  movimientosStockDestino MovimientoStock[] @relation("MovimientoDestino")
  inventario       SucursalProducto[]
  tickets          TicketReparacion[]
  usuarios         Usuario[]
  ventas           Venta[]
}

model SucursalProducto {
  sucursalId String
  productoId String
  stock      Int      @default(0)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([sucursalId, productoId])
  @@index([sucursalId])
  @@index([productoId])
}

model Usuario {
  id                       String             @id @default(uuid())
  nombre                   String
  rol                      RolUsuario
  email                    String             @unique
  password_hash            String
  porcentaje_comision_base Float              @default(0.40)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  sucursalId               String?
  permisos                 Json?

  gana_comision            Boolean            @default(true)
  gana_salario             Boolean            @default(false)
  salario_base_usd         Float              @default(0)
  tickets_asignados        TicketReparacion[]
  sucursal                 Sucursal?          @relation(fields: [sucursalId], references: [id])
  ventas_realizadas        Venta[]
  movimientos_stock        MovimientoStock[]

  @@index([sucursalId])
}

model Cliente {
  id               String             @id @default(uuid())
  nombre           String
  cedula           String             @unique
  telefono         String
  correo           String?
  password_hash    String?
  tipo_cliente     TipoClienteWeb     @default(DETAL)
  estado_mayorista EstadoMayorista    @default(NINGUNO)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tickets          TicketReparacion[]
  ventas           Venta[]
  direcciones      DireccionCliente[]
  pedidos_online   PedidoOnline[]
}

model Producto {
  id                    String             @id @default(uuid())
  sku                   String             @unique
  nombre                String
  slug                  String?            @unique
  descripcion           String?
  imagenes              String[]           @default([])
  marca_comp            String?
  modelo_comp           String?
  categoria             CategoriaProducto  @default(REPUESTO)
  categoriaId           String?
  categoria_rel         Categoria?         @relation(fields: [categoriaId], references: [id])
  marcaId               String?
  marca                 Marca?             @relation(fields: [marcaId], references: [id])
  propiedad             TipoPropiedad      @default(PROPIA)
  propietario           String?
  stock_actual          Int                @default(0)
  stock_minimo          Int                @default(2)
  costo_usd             Float
  precio_usd            Float              // Detal / PVP
  precio_mayor_usd      Float?             // Precio Mayor
  precio_gran_mayor_usd Float?             // Precio Gran Mayor
  min_unidades_mayor    Int?               @default(3)
  min_unidades_gran_mayor Int?             @default(10)
  especificaciones      Json?              // Specs dinámicas: potencia, mAh, GaN, BT, etc.
  publicado_web         Boolean            @default(false)
  destacado_web         Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  activo                Boolean            @default(true)
  movimientos           MovimientoStock[]
  inventario_sucursales SucursalProducto[]
  tickets               Ticket_Producto[]
  ventas                Venta_Producto[]
  egresos               TransaccionFinanciera[]
  items_pedido_online   ItemPedidoOnline[]

  @@index([categoria])
  @@index([categoriaId])
  @@index([marcaId])
  @@index([propiedad])
  @@index([publicado_web])
}

model MovimientoStock {
  id                 String         @id @default(uuid())
  productoId         String
  tipo               TipoMovimiento
  cantidad           Int
  referencia         String?
  nota               String?
  createdAt          DateTime       @default(now())
  actualizar_costo   Boolean        @default(false)
  costo_unitario_usd Float?
  sucursalId         String?
  sucursalDestinoId  String?
  usuarioId          String?
  producto           Producto       @relation(fields: [productoId], references: [id])
  sucursal           Sucursal?      @relation("MovimientoOrigen", fields: [sucursalId], references: [id])
  sucursalDestino    Sucursal?      @relation("MovimientoDestino", fields: [sucursalDestinoId], references: [id])
  usuario            Usuario?       @relation(fields: [usuarioId], references: [id])

  @@index([productoId])
  @@index([tipo])
  @@index([createdAt])
  @@index([sucursalId])
  @@index([usuarioId])
}

model Servicio {
  id         String            @id @default(uuid())
  nombre     String
  precio_usd Float
  createdAt  DateTime          @default(now())
  tickets    Ticket_Servicio[]
}

model TicketReparacion {
  id                  String                  @id @default(uuid())
  clienteId           String
  tecnicoId           String?
  equipo              String?
  tipo_equipo         String                  @default("Smartphone")
  marca               String
  modelo              String
  imei                String?
  clave               String?
  patron_visual       String?
  checklist           Json?
  falla               String
  falla_reportada     String?
  observaciones       String?
  estado              EstadoTicket            @default(RECIBIDO)
  costo_repuestos_usd Float                   @default(0)
  precio_total_usd    Float                   @default(0)
  porcentaje_tecnico  Float                   @default(0.40)
  fecha_ingreso       DateTime                @default(now())
  fecha_entrega       DateTime?
  sucursalId          String?
  pagos               Pago[]
  cliente             Cliente                 @relation(fields: [clienteId], references: [id])
  sucursal            Sucursal?               @relation(fields: [sucursalId], references: [id])
  tecnico             Usuario?                @relation(fields: [tecnicoId], references: [id])
  repuestos           Ticket_Producto[]
  servicios           Ticket_Servicio[]
  transacciones       TransaccionFinanciera[]

  @@index([estado])
  @@index([fecha_ingreso])
  @@index([sucursalId])
}

model Ticket_Producto {
  id                   String           @id @default(uuid())
  ticketId             String
  productoId           String
  cantidad             Int              @default(1)
  precio_congelado_usd Float
  costo_congelado_usd  Float
  producto             Producto         @relation(fields: [productoId], references: [id])
  ticket               TicketReparacion @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Ticket_Servicio {
  id                   String           @id @default(uuid())
  ticketId             String
  servicioId           String
  precio_cobrado_usd   Float
  comision_tecnico_usd Float
  servicio             Servicio         @relation(fields: [servicioId], references: [id])
  ticket               TicketReparacion @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Venta {
  id                    String                  @id @default(uuid())
  clienteId             String?
  vendedorId            String?
  numero                Int                     @unique @default(autoincrement())
  numero_control        String?                 // Estilo fiscal a2 (ej: "00006528")
  tipo_documento        TipoDocumentoVenta      @default(NOTA_ENTREGA)
  subtotal_usd          Float
  descuento_usd         Float                   @default(0)
  flete_usd             Float                   @default(0)
  iva_usd               Float                   @default(0)
  total_usd             Float
  tasa_bcv_snapshot     Float?                  // Tasa de cambio oficial del día
  total_bs_snapshot     Float?                  // Total en Bolívares
  estado                EstadoVenta             @default(PENDIENTE)
  createdAt             DateTime                @default(now())
  fecha_vencimiento     DateTime?               // Para ventas a crédito
  observaciones         String?
  sucursalId            String?
  tasas_cambio_snapshot Json?
  pagos                 Pago[]
  transacciones         TransaccionFinanciera[]
  cliente               Cliente?                @relation(fields: [clienteId], references: [id])
  sucursal              Sucursal?               @relation(fields: [sucursalId], references: [id])
  vendedor              Usuario?                @relation(fields: [vendedorId], references: [id])
  items                 Venta_Producto[]

  @@index([estado])
  @@index([createdAt])
  @@index([sucursalId])
  @@index([tipo_documento])
}

model Venta_Producto {
  id                   String   @id @default(uuid())
  ventaId              String
  productoId           String
  cantidad             Int      @default(1)
  precio_congelado_usd Float
  costo_congelado_usd  Float
  producto             Producto @relation(fields: [productoId], references: [id])
  venta                Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
}

model Moneda {
  id          String   @id @default(uuid())
  codigo      String   @unique
  nombre      String?
  tasa_cambio Float    @default(1)
  updatedAt   DateTime @updatedAt
  pagos       Pago[]
}

model Pago {
  id                 String            @id @default(uuid())
  ticketId           String?
  ventaId            String?
  monedaId           String
  monto_moneda_local Float
  equivalente_usd    Float
  referencia         String?
  fecha_pago         DateTime          @default(now())
  metodo             MetodoPago
  tasa_cambio_usada  Float?
  moneda             Moneda            @relation(fields: [monedaId], references: [id])
  ticket             TicketReparacion? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  venta              Venta?            @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([fecha_pago])
}

model TransaccionFinanciera {
  id        String            @id @default(uuid())
  tipo      TipoTransaccion
  monto_usd Float
  concepto  String
  categoria String?
  ticketId  String?
  ventaId   String?
  productoId String?
  esFijo    Boolean           @default(false)
  createdAt DateTime          @default(now())
  ticket    TicketReparacion? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  venta     Venta?            @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  producto  Producto?         @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@index([tipo])
  @@index([createdAt])
  @@index([categoria])
}

model GastoRecurrente {
  id           String           @id @default(uuid())
  concepto     String
  monto_usd    Float
  categoria    String?          @default("OTROS")
  frecuencia   FrecuenciaGasto  @default(MENSUAL)
  proximaFecha DateTime
  activo       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([proximaFecha])
  @@index([activo])
}

model Categoria {
  id                   String     @id @default(uuid())
  nombre               String     @unique // "AUDÍFONOS", "CARGA", "POWER BANK", "CABLES", "BATERÍAS"
  slug                 String     @unique // "audifonos", "carga", "power-bank"
  icono                String?    // Icono para la web o dashboard
  categorias_sugeridas String[]   @default([]) // Para venta cruzada (cross-selling)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  productos            Producto[]
}

model Marca {
  id        String     @id @default(uuid())
  nombre    String     @unique
  slug      String?    @unique // "1hora", "ugreen", "movisun"
  logo_url  String?    // Logo oficial para carrusel en la web
  createdAt DateTime   @default(now())
  modelos   Modelo[]
  productos Producto[]
}

model Modelo {
  id        String   @id @default(uuid())
  nombre    String
  marcaId   String
  createdAt DateTime @default(now())
  marca     Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)

  @@unique([nombre, marcaId])
  @@index([marcaId])
}

model DireccionCliente {
  id          String   @id @default(uuid())
  clienteId   String
  alias       String   @default("Principal") // "Casa", "Oficina", "Taller"
  nombre_dest String?  // Nombre de la persona que recibe
  telefono    String?
  direccion   String
  ciudad      String
  estado      String
  codigo_post String?
  es_default  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model PedidoOnline {
  id               String             @id @default(uuid())
  numero           Int                @unique @default(autoincrement())
  clienteId        String?
  nombre_invitado  String?
  telefono_invit   String?
  correo_invit     String?
  direccion_texto  String?
  subtotal_usd     Float
  descuento_usd    Float              @default(0)
  total_usd        Float
  estado           EstadoPedidoOnline @default(PENDIENTE_PAGO)
  metodo_pago      MetodoPago?
  referencia_pago  String?
  comprobante_url  String?
  tasa_bcv         Float?
  total_bs         Float?
  cuponCodigo      String?
  cupon            CuponDescuento?    @relation(fields: [cuponCodigo], references: [codigo])
  cliente          Cliente?           @relation(fields: [clienteId], references: [id])
  items            ItemPedidoOnline[]
  ventaId          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([clienteId])
  @@index([estado])
  @@index([createdAt])
}

model ItemPedidoOnline {
  id              String       @id @default(uuid())
  pedidoId        String
  productoId      String
  cantidad        Int          @default(1)
  precio_unit_usd Float
  total_usd       Float
  pedido          PedidoOnline @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto        Producto     @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@index([productoId])
}

model CuponDescuento {
  id                String           @id @default(uuid())
  codigo            String           @unique
  descripcion       String?
  tipo              TipoCupon        @default(PORCENTAJE)
  valor             Float            // Ej: 10 para 10%, o 5.00 para $5
  compra_minima_usd Float            @default(0)
  limite_usos       Int?
  usos_actuales     Int              @default(0)
  roles_permitidos  TipoClienteWeb[] @default([DETAL, MAYORISTA, GRAN_MAYOR])
  activo            Boolean          @default(true)
  fecha_expiracion  DateTime?
  createdAt         DateTime         @default(now())
  pedidos           PedidoOnline[]
}

model Configuracion {
  id                 Int      @id @default(1)
  nombre_local       String   @default("TechLand")
  nombre_comercial   String?  @default("TechLand")
  razon_social       String?  // Ej: "TECHLAND SOLUTIONS C.A."
  rif                String?  // Ej: "J-12345678-9"
  slogan             String?  // Ej: "Tecnología, Accesorios y Servicio Técnico Especializado"
  logo_url           String?  // Logo transparente para facturas, PDFs y cabecera web
  direccion_fiscal   String?
  telefono_principal String?  // Sale en facturas
  whatsapp_pedidos   String?  // Destino de botones WhatsApp de la tienda
  correo_contacto    String?
  pie_factura_legal  String?  @default("Garantía válida únicamente presentando este documento original.")
  porcentaje_defecto Float    @default(0.40)
  updatedAt          DateTime @updatedAt
}

model SyncLog {
  id         String   @id @default(uuid())
  sucursalId String
  lastSync   DateTime
  status     String   // "SUCCESS", "FAILED"
  createdAt  DateTime @default(now())

  @@index([sucursalId])
}

enum RolUsuario {
  ADMIN
  TECNICO
  VENDEDOR
}

enum EstadoTicket {
  RECIBIDO
  EN_REVISION
  ESPERANDO_REPUESTO
  REPARADO
  ENTREGADO
  ABANDONO
}

enum CategoriaProducto {
  EQUIPO
  ACCESORIO
  REPUESTO
}

enum TipoClienteWeb {
  DETAL
  MAYORISTA
  GRAN_MAYOR
}

enum EstadoMayorista {
  NINGUNO
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoPedidoOnline {
  PENDIENTE_PAGO
  VERIFICANDO_PAGO
  PAGADO
  EN_PREPARACION
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum TipoDocumentoVenta {
  FACTURA
  NOTA_ENTREGA
  PRESUPUESTO
  PEDIDO_WEB
}

enum TipoCupon {
  PORCENTAJE
  MONTO_FIJO
}

enum TipoPropiedad {
  PROPIA
  PRESTADA
}

enum EstadoVenta {
  PENDIENTE
  PAGADA
  ANULADA
}

enum TipoMovimiento {
  ENTRADA
  SALIDA_REPARACION
  SALIDA_VENTA
  AJUSTE
  DEVOLUCION
  TRASLADO
}

enum TipoTransaccion {
  INGRESO
  EGRESO
}

enum MetodoPago {
  EFECTIVO
  PAGO_MOVIL
  ZELLE
  TRANSFERENCIA
  BINANCE
  PUNTO_DE_VENTA
}

enum FrecuenciaGasto {
  DIARIO
  SEMANAL
  MENSUAL
}
